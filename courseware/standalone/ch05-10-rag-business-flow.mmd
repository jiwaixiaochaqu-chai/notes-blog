%%{init: {"theme": "base", "flowchart": {"htmlLabels": true, "curve": "basis", "nodeSpacing": 42, "rankSpacing": 58}, "themeVariables": {"fontFamily": "Microsoft YaHei, Segoe UI, Arial, sans-serif", "fontSize": "17px", "primaryColor": "#ffffff", "primaryTextColor": "#111827", "primaryBorderColor": "#cbd5e1", "lineColor": "#64748b"}}}%%
flowchart TD
    LEG09["图例：第09章<br/>用户入口与服务门面"]:::ch09
    LEG10["图例：第10章<br/>问答主流程与收口"]:::ch10
    LEG10P["图例：第10章<br/>回答口径与 Prompt 策略"]:::ch10

    A["用户在页面发起问题<br/>可选业务分类 / 会话 / 数据权限"] --> B["第09章：统一问答入口<br/>把 HTTP / WebSocket 请求交给问答服务"]:::ch09

    B --> C["第10章：建立本次问答任务<br/>确定场景、会话、知识库版本、租户与 Trace"]:::ch10

    C --> D["清洗用户问题<br/>去掉无效空白和礼貌开头，保留业务问题"]

    D --> E{"是否能立即给出确定性回应？"}

    E -->|"问候 / 感谢 / 转人工"| F["直接回应<br/>介绍助手或给出人工支持入口"]
    E -->|"越界 / 风险问题"| G["拒答或提示不支持<br/>不进入知识库检索"]
    E -->|"用户选错业务分类"| H["提示切换分类<br/>避免按错误资料回答"]
    E -->|"标准 FAQ 精确命中"| I["返回标准 FAQ 答案<br/>跳过文档检索和 LLM 生成"]

    F --> Z["第10章：统一收口<br/>返回答案、写历史、记录 Trace"]:::ch10
    G --> Z
    H --> Z
    I --> Z

    E -->|"需要查知识库"| J["进入知识检索流程<br/>继续理解问题和准备证据"]

    J --> K["加载会话上下文<br/>带上历史摘要和最近对话"]

    K --> L{"用户问题属于哪类？"}

    L -->|"标准问答类"| M["FAQ 类问题<br/>流程、怎么办、需要哪些材料"]
    L -->|"知识综合类"| N["文档知识问题<br/>制度解释、规则说明、多资料综合"]
    L -->|"追问类"| O["上下文追问<br/>例如：那审批呢、这个怎么办"]

    M --> P["形成业务理解结果<br/>问题类型、规则分数、模型分数、最终分数、决策策略、建议业务分类、是否需要改写"]
    N --> P
    O --> P

    P --> Q{"是否需要结合历史改写？"}

    Q -->|"是"| R["把追问补全成独立问题<br/>例如：那审批呢 -> 新人入职审批流程是什么"]
    Q -->|"否"| S["保持当前业务问题"]

    R --> T["得到可检索问题"]
    S --> T

    T --> U["制定检索计划<br/>决定查 FAQ、查文档、查多少、阈值多保守"]

    U --> V{"问题风险与复杂度"}

    V -->|"短问题"| W["提高 FAQ 直出门槛<br/>避免一句话问题误命中"]
    V -->|"低决策分数"| X["扩大证据召回<br/>用更多资料降低误判风险"]
    V -->|"合规 / 费用 / 排障 / 总结"| Y["使用更保守策略<br/>更多文档证据、更明确边界"]
    V -->|"表格 / 清单 / 字段"| Y2["偏向文档和表格证据<br/>避免模糊 FAQ 截断"]

    W --> U2["得到最终检索方案"]
    X --> U2
    Y --> U2
    Y2 --> U2

    U2 --> V2{"是否需要多种问法检索？"}

    V2 -->|"需要"| V3["生成等价查询表达<br/>流程 / SOP / 办理步骤等多路召回"]
    V2 -->|"不需要"| V4["使用当前问题检索"]

    V3 --> P10A["第10章：选择回答口径<br/>按问题类型选择 FAQ、知识、追问、合规、费用、排障等模板"]:::ch10
    V4 --> P10A

    P10A --> AA["确定检索边界<br/>当前知识库版本、业务分类、租户、数据集、角色权限"]

    AA --> AB{"检索计划要求查 FAQ？"}
    AB -->|"是"| AC["检索 FAQ 候选<br/>找到相似标准问题和标准答案"]
    AB -->|"否"| AD["跳过 FAQ"]

    AC --> AE["FAQ 候选排序<br/>语义 + 关键词 + 去重 + 可选重排"]
    AD --> AF["FAQ 结果为空"]
    AE --> AG{"FAQ 是否足够确定？"}
    AF --> AG

    AG -->|"是"| AH["使用标准 FAQ 答案<br/>带来源返回"] 
    AH --> Z

    AG -->|"否"| AI{"检索计划要求查文档？"}

    AI -->|"是"| AJ["检索文档证据<br/>从制度、流程、PDF、表格等资料召回片段"]
    AI -->|"否"| AK["没有可用文档候选"]

    AJ --> AL["文档候选排序<br/>语义 + 关键词 + 去重 + 可选重排"]
    AK --> AM["证据不足"]
    AL --> AN["合并 FAQ 与文档证据<br/>筛掉低分内容，保留最相关来源"]
    AM --> AN

    AN --> AO{"是否有足够证据？"}

    AO -->|"没有"| AP["返回信息不足<br/>不编造答案，提示补充材料或联系人工"]:::ch10
    AP --> Z

    AO -->|"有"| P10B["第10章：组织回答口径<br/>把历史、问题、证据放入合适的回答模板"]:::ch10

    P10B --> AQ["生成可引用答案<br/>按证据回答，必要时步骤化、风险化或边界化表达"]:::ch10

    AQ --> AR["补强引用来源<br/>确保答案能看到来源编号"]

    AR --> AS{"引用后是否仍然可信？"}

    AS -->|"不可信"| AT["回退为信息不足<br/>避免无依据输出"]:::ch10
    AT --> Z

    AS -->|"可信"| AU["流式展示给用户<br/>边生成边显示"]:::ch10

    AU --> Z

    Z --> AV["最终业务结果<br/>答案 / 来源 / 命中路径 / 意图 / 耗时 / Trace"]:::ch10

    classDef ch09 fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#0f172a;
    classDef ch10 fill:#ffedd5,stroke:#f97316,stroke-width:2px,color:#0f172a;
